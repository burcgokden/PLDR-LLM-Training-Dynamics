  "forbidden": [
    "raw_model_node",
    "raw_optimizer_node",
    "raw_parameter_node",
    "normalized_shape",
    "normalized_shape_node",
    "pickle"
  ],
  "probe_invariant": "An energy sequence may telescope only when every node carries the same probe_registry_sha256 and probe_chunk_ids_sha256. Changing actual update batches is expected and is recorded separately.",
