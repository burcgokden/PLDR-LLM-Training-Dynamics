{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_root": {
      "minLength": 1,
      "type": "string"
    },
    "artifacts": {
      "minProperties": 1,
      "type": "object"
    },
    "campaign_id": {
      "minLength": 1,
      "type": "string"
    },
    "protocol": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "pldr-evidence-request-v4"
    },
    "stage": {
      "enum": [
        "Q",
        "T",
        "TR",
        "N",
        "D",
        "I",
        "A",
        "S2N",
        "R",
        "CONSTRUCTION"
      ]
    }
  },
  "required": [
    "schema_version",
    "campaign_id",
    "stage",
    "artifact_root",
    "protocol",
    "artifacts",
    "request_sha256"
  ],
  "title": "Checkpoint-bound stage evidence request",
  "type": "object"
}
