{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "arrays": {
      "allOf": [
        {
          "contains": {
            "const": "prediction_sha256"
          }
        },
        {
          "contains": {
            "const": "observed_centered_responses"
          }
        }
      ],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "campaign_id": {
      "const": "pldr-observable-full-state-cocycle-v1"
    },
    "schema_version": {
      "const": "pldr-observable-cocycle-validation-v1"
    },
    "source_step": {
      "minimum": 0,
      "type": "integer"
    },
    "trajectory": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "campaign_id",
    "trajectory",
    "source_step",
    "arrays"
  ],
  "title": "Held-out signed nonlinear validation",
  "type": "object"
}
