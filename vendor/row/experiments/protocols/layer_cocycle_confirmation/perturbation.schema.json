{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "arrays": {
      "allOf": [
        {
          "contains": {
            "const": "prediction_sha256"
          }
        },
        {
          "contains": {
            "const": "relative_residual"
          }
        },
        {
          "contains": {
            "const": "endpoint_distance_by_map"
          }
        }
      ],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "campaign_id": {
      "const": "pldr-layer-resolved-cocycle-confirmation-v1"
    },
    "schema_version": {
      "const": "pldr-layer-cocycle-perturbation-v1"
    },
    "step": {
      "minimum": 0,
      "type": "integer"
    },
    "trajectory": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "campaign_id",
    "trajectory",
    "step",
    "arrays"
  ],
  "title": "Source-written sign-paired perturbation validation",
  "type": "object"
}
