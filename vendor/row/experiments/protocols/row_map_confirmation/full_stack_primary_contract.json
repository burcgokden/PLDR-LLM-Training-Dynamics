    "entry": {
      "certificate_checkpoints": [
        8000,
        9000,
        10000,
        11000,
        12000,
        13000,
        14000,
        15000
      ],
      "criterion": 1.0,
      "criterion_unit": "output_row_unit_per_input_row_unit",
